        "uWarp": 0.1,
        "rot_speed": 0.02
      }
    },
    "chorus": {
      "every": 4,
      "transition": "dissolve",
      "burn_beats": 6,
      "fx": {
        "uSparks": 0.3,
        "uWarp": 0.1,
        "bloom": 1.3,
        "uKaleido": 0.12,
        "uKSeg": 6.0,
        "uSat": 1.05
      }
    },
    "breakdown": {
      "every": 8,
      "transition": "dissolve",
      "burn_beats": 8,
      "fx": {
        "uSparks": 0.1,
        "uWarp": 0.12
      }
    },
    "solo": {
      "every": 4,
      "transition": "dissolve",
      "burn_beats": 6,
      "fx": {
        "uSparks": 0.25,
        "uWarp": 0.1
      }
    },
    "outro": {
      "every": 8,
      "transition": "dissolve",
      "burn_beats": 8,
      "fx": {
        "uBright": 0.8,
        "uSparks": 0.08
      }
    }
  },
