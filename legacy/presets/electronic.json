      "fx": {
        "uKickZoom": 0.0,
        "drift": 0.15,
        "uGlitch": 0.04
      }
    },
    "verse": {
      "every": 2,
      "transition": "cut",
      "burn_beats": 0.25,
      "fx": {
        "uKickZoom": 0.05,
        "uGlitch": 0.08,
        "uSparks": 0.15
      }
    },
    "pre": {
      "every": 1,
      "transition": "dissolve",
      "burn_beats": 1,
      "fx": {
        "uWarp": 0.05,
        "rot_speed": 0.05,
        "uGlitch": 0.1,
        "uSparks": 0.3
      }
    },
    "chorus": {
      "every": 1,
      "transition": "cut",
      "burn_beats": 0.25,
      "blend_beats": 0.25,
      "fx": {
        "uTunnel": 0.3,
        "uKaleido": 0.35,
        "kaleido_pulse": 0.3,
        "spin_speed": 0.4,
        "uGlitch": 0.2,
        "uChroma": 1.1,
        "uKickZoom": 0.09,
        "kick_flash": 0.15,
        "uNeon": 0.12,
        "uSparks": 0.5,
        "bloom": 1.1,
        "uSat": 1.3
      }
    },
    "breakdown": {
      "every": 4,
      "transition": "dissolve",
      "burn_beats": 3,
      "fx": {
        "uWarp": 0.08,
        "rot_speed": 0.06,
        "uGlitch": 0.15,
        "uKickZoom": 0.0
      }
    },
    "solo": {
      "every": 1,
      "transition": "cut",
      "burn_beats": 0.25,
      "fx": {
        "uTunnel": 0.45,
        "uKaleido": 0.5,
        "uNeon": 0.3,
        "spin_speed": 0.8
      }
    },
    "outro": {
      "every": 8,
      "transition": "dissolve",
      "burn_beats": 3,
      "fx": {
        "uKickZoom": 0.0,
        "drift": 0.15,
        "uBright": 0.85
      }
    }
  },
