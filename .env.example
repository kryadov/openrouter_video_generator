# Copy to .env and fill in. Environment variables override values from .env.

# OpenRouter API key (https://openrouter.ai/keys). The only secret in this project.
OPENROUTER_API_KEY=sk-or-v1-...

# Hard cap (USD) on the TOTAL spend recorded in output/_ledger.json. Jobs that would push the
# ledger over this value are refused before they are submitted.
VIDEO_BUDGET_USD=10

# Part 1 (compare): models that render the same shot list side by side — 4, 6 or 8 work best.
# Full list with prices: GET https://openrouter.ai/api/v1/videos/models (cached in output/_video_models.json)
COMPARE_MODELS=google/veo-3.1-lite,google/veo-3.1-fast,kwaivgi/kling-v3.0-std,bytedance/seedance-2.0-fast
# Other good candidates: bytedance/seedance-2.0,bytedance/seedance-2.5,alibaba/wan-3.0,minimax/hailuo-3-max,runway/gen-4.5

# Part 2 (refine): the model chosen after the comparison.
REFINE_MODEL=bytedance/seedance-2.0-fast

# Generation resolution for new shot lists (480p is cheaper, 720p recommended).
VIDEO_RESOLUTION=720p

# H.264 encoder: auto (NVENC if a working NVIDIA GPU is found, else CPU libx264) | nvenc | x264
VIDEO_ENCODER=auto

# Optional casting rule prepended to every generated prompt, e.g. "all people on screen are European".
VIDEO_CAST=
